---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
---

<DefaultHead {...Astro.props} />

<script type="module">
  import mixpanel from "mixpanel-browser";

  // Create an instance of the Mixpanel object
  mixpanel.init('c04075cf5492a7b007fb6be49298598a', {
    autocapture: true,
    record_sessions_percent: 100,
  });

  // Expose to window for any other scripts that need access
  window.mixpanel = mixpanel;

  // --- Tracking logic ---

  function getPageType(path) {
    if (path.startsWith('/guides/')) return 'tutorial';
    if (path.startsWith('/abbreviations/')) return 'abbreviation';
    if (path.startsWith('/terms/')) return 'reference';
    if (path.startsWith('/reference/')) return 'reference';
    if (path.startsWith('/apps/') || path.startsWith('/tools/')) return 'tool';
    return 'other';
  }

  // Track page view on load
  const path = window.location.pathname;
  const pageType = getPageType(path);

  mixpanel.track('page_viewed', {
    page_title: document.title,
    page_url: window.location.href,
    page_type: pageType,
  });

  // Track tutorial_read (Value Moment) after 10 seconds on tutorial pages
  if (pageType === 'tutorial') {
    const startTime = Date.now();
    const timer = setTimeout(() => {
      const timeOnPage = Math.round((Date.now() - startTime) / 1000);
      mixpanel.track('tutorial_read', {
        page_title: document.title,
        page_url: window.location.href,
        page_path: path,
        time_on_page: timeOnPage,
      });
    }, 10000);

    window.addEventListener('beforeunload', () => {
      clearTimeout(timer);
    });
  }
</script>
