---
import Default from '@astrojs/starlight/components/TwoColumnContent.astro';
import AIDropdownTools from './AIDropdownTools.astro';
---

<Default {...Astro.props}>
  <div class="content-with-ai-tools">
    <slot />
    <div class="ai-tools-container">
      <AIDropdownTools client:load />
    </div>
  </div>
</Default>

<style>
  .content-with-ai-tools {
    position: relative;
  }
  
  .ai-tools-container {
    position: absolute;
    top: -3rem;
    right: 0;
    z-index: 10;
  }
  
  @media (max-width: 768px) {
    .ai-tools-container {
      position: static;
      margin-bottom: 1rem;
      text-align: right;
    }
  }
</style>