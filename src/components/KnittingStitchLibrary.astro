---
// KnittingStitchLibrary.astro
---

<div id="knitting-stitch-library" class="w-full bg-gray-50">
  <div class="loading-message text-center py-12">
    <div class="text-4xl mb-4">🧶</div>
    <p class="text-gray-600">Loading Knitting Stitch Pattern Library...</p>
  </div>
</div>

<script>
// Import React from CDN since we can't use ES6 imports in Astro script tags
const script = document.createElement('script');
script.src = 'https://unpkg.com/react@18/umd/react.development.js';
script.onload = () => {
  const reactDOMScript = document.createElement('script');
  reactDOMScript.src = 'https://unpkg.com/react-dom@18/umd/react-dom.development.js';
  reactDOMScript.onload = initializeKnittingLibrary;
  document.head.appendChild(reactDOMScript);
};
document.head.appendChild(script);

function initializeKnittingLibrary() {
  const { useState, createElement: h, Fragment } = React;
  const { createRoot } = ReactDOM;

  const stitchLibrary = {
    'garter-stitch': {
      id: 'garter-stitch', name: 'Garter Stitch', difficulty: 'Beginner', category: 'Basic',
      description: 'The simplest knitting stitch pattern, created by knitting every row. Produces a squishy, ridged fabric that lies flat and looks the same on both sides.',
      instructions: ['Knit every row', 'For flat knitting: knit all stitches on both right side and wrong side rows', 'For circular knitting: knit one round, purl one round alternately', 'Repeat for desired length'],
      tips: ['Perfect for beginners — only one stitch to learn', 'Does not curl at the edges, so borders are not needed', 'Reversible — both sides look identical with horizontal ridges', 'Every ridge equals two rows of knitting, making row counting easy'],
      variations: ['Garter stitch in the round (alternate knit and purl rounds)', 'Garter stitch stripes (alternate colors every 2 rows)', 'Garter stitch with slipped edges for cleaner sides'],
    },
    'stockinette-stitch': {
      id: 'stockinette-stitch', name: 'Stockinette Stitch', difficulty: 'Beginner', category: 'Basic',
      description: 'The most common knitting pattern, created by alternating knit and purl rows. Forms smooth V-shaped columns on the right side and bumpy ridges on the wrong side.',
      instructions: ['Row 1 (Right Side): Knit all stitches', 'Row 2 (Wrong Side): Purl all stitches', 'Repeat rows 1-2 for pattern', 'For circular knitting: knit every round'],
      tips: ['Naturally curls at the edges — add a garter, seed, or ribbed border', 'Count rows by counting the V columns on the right side', 'The purl bumps form a grid that is perfect for duplicate stitch embroidery', 'Blocking helps flatten the fabric but does not permanently stop curling'],
      variations: ['Stockinette in the round (knit every round)', 'Striped stockinette (alternate colors on right side rows)', 'Twisted stockinette (knit through back loop)'],
    },
    'reverse-stockinette': {
      id: 'reverse-stockinette', name: 'Reverse Stockinette', difficulty: 'Beginner', category: 'Basic',
      description: 'The purl side of stockinette used as the right side. Creates a bumpy, textured surface that is the opposite of smooth stockinette.',
      instructions: ['Row 1 (Right Side): Purl all stitches', 'Row 2 (Wrong Side): Knit all stitches', 'Repeat rows 1-2 for pattern', 'For circular knitting: purl every round'],
      tips: ['Commonly used as the background for cables and colorwork to make designs pop', 'Also curls like regular stockinette and needs border treatment', 'Creates a matte, textured surface that hides imperfections well', 'Often paired with stockinette for contrast in textured designs'],
      variations: ['Reverse stockinette in the round (purl every round)', 'Reverse stockinette borders', 'Alternating stockinette and reverse stockinette panels'],
    },
    'garter-ridge': {
      id: 'garter-ridge', name: 'Garter Ridge', difficulty: 'Beginner', category: 'Basic',
      description: 'Alternating bands of garter and stockinette create horizontal ridges that add subtle texture and visual interest.',
      instructions: ['Rows 1-4: Knit all stitches (2 garter ridges)', 'Rows 5-6: Row 5 Knit, Row 6 Purl (1 stockinette ridge)', 'Repeat rows 1-6 for pattern', 'Adjust the number of garter rows to change ridge width'],
      tips: ['Each garter ridge = 2 knit rows, each stockinette ridge = 1 knit + 1 purl row', 'Varying the ridge widths creates different looks — try 6 garter + 2 stockinette', 'The stockinette sections create a slight color change if using hand-dyed yarn', 'Lies flatter than plain stockinette due to the garter bands'],
      variations: ['Narrow ridges (2 garter rows + 2 stockinette rows)', 'Wide ridges (8 garter rows + 2 stockinette rows)', 'Seed stitch ridges instead of garter'],
    },
    'k1-p1-ribbing': {
      id: 'k1-p1-ribbing', name: 'K1 P1 Ribbing', difficulty: 'Beginner', category: 'Ribbing',
      description: 'Alternating knit 1, purl 1 across each row. Creates a stretchy, vertical striped fabric that is the standard for cuffs, hems, and neckbands.',
      instructions: ['Cast on an even number of stitches', 'Row 1: *Knit 1, Purl 1* repeat across', 'Row 2: Knit the knit stitches and purl the purl stitches (they will appear as you face them)', 'Repeat row 2 for pattern'],
      tips: ['Very elastic — ideal for cuffs, hat brims, and sweater hems', 'Use a stretchy cast-on like the long-tail or tubular cast-on for best results', 'Use needles 1-2 sizes smaller than the main fabric for tighter, neater ribbing', 'The fabric will pull in compared to stockinette, so cast on extra stitches if needed'],
      variations: ['K1 P1 in the round (knit 1, purl 1 around every round)', 'Broken rib (knit 1, purl 1 on row 1, knit all stitches on row 2)', 'K1 P1 with twisted knits for extra definition'],
    },
    'k2-p2-ribbing': {
      id: 'k2-p2-ribbing', name: 'K2 P2 Ribbing', difficulty: 'Beginner', category: 'Ribbing',
      description: 'Alternating knit 2, purl 2 across each row. Creates wider vertical stripes with slightly less elasticity than K1 P1.',
      instructions: ['Cast on a multiple of 4 stitches', 'Row 1: *Knit 2, Purl 2* repeat across', 'Row 2: Knit the knit stitches and purl the purl stitches', 'Repeat row 2 for pattern'],
      tips: ['Cast on in multiples of 4 for symmetry', 'Creates bolder stripes than K1 P1 ribbing', 'Slightly less elastic than K1 P1 — use for sweater bands and cardigan fronts', 'Use a stretchy cast-on to maintain fabric stretch'],
      variations: ['K2 P2 in the round (knit 2, purl 2 around)', 'K3 P1 ribbing for a different stripe ratio', 'K1 P3 ribbing for an asymmetric look'],
    },
    'seed-stitch': {
      id: 'seed-stitch', name: 'Seed Stitch', difficulty: 'Beginner', category: 'Textured',
      description: 'Alternating knit and purl stitches that create a bumpy, pebbled texture. Knits and purls are staggered every row, so each stitch is the opposite of the one below it.',
      instructions: ['Cast on an odd number of stitches', 'Row 1: *Knit 1, Purl 1* repeat across, end with Knit 1', 'Row 2: *Purl 1, Knit 1* repeat across, end with Purl 1', 'Repeat rows 1-2 for pattern'],
      tips: ['Lies perfectly flat — does not curl at all, making it ideal for scarf and blanket edges', 'Reversible — both sides look identical', 'Use a multiple of 2 plus 1 extra stitch for symmetry on both sides', 'The fabric is dense and somewhat rigid compared to stockinette'],
      variations: ['Seed stitch in the round (alternate knit 1, purl 1 and purl 1, knit 1 each round)', 'Seed stitch borders on stockinette fabric', 'Striped seed stitch with color changes'],
    },
    'double-seed-stitch': {
      id: 'double-seed-stitch', name: 'Double Seed Stitch', difficulty: 'Intermediate', category: 'Textured',
      description: 'A two-row version of seed stitch with larger, more pronounced bumps. Creates a bolder textured fabric that lies flat.',
      instructions: ['Cast on an even number of stitches', 'Rows 1-2: *Knit 1, Purl 1* repeat across', 'Rows 3-4: *Purl 1, Knit 1* repeat across', 'Repeat rows 1-4 for pattern'],
      tips: ['Less busy than regular seed stitch — good for larger projects like blankets', 'Also lies completely flat and does not curl', 'Great for menswear and home decor projects', 'Same on both sides, making it perfect for scarves'],
      variations: ['Four-row seed stitch (longer repeats for even larger texture)', 'Double seed stitch in the round', 'Double seed stitch with twisted stitches for extra definition'],
    },
    'twisted-k1-p1-half-twist': {
      id: 'twisted-k1-p1-half-twist', name: 'Twisted K1 P1 Ribbing (Half Twist)', difficulty: 'Intermediate', category: 'Ribbing',
      description: 'Knit stitches are worked through the back loop on right side rows, creating a tighter, more defined rib with smaller V shapes.',
      instructions: ['Cast on an even number of stitches', 'Row 1 (RS): *Knit 1 through back loop, Purl 1* repeat across', 'Row 2 (WS): *Knit 1, Purl 1 through back loop* repeat across', 'Repeat rows 1-2 for pattern'],
      tips: ['Creates very tidy, well-defined ribbing that looks professional', 'The twisted knit stitches make the ribbing slightly less stretchy than regular K1 P1', 'Ideal for sock cuffs where extra grip is helpful', 'Half twist means only the knit stitches are twisted on the right side'],
      variations: ['Twisted K2 P2 ribbing (half twist)', 'Twisted rib in the round (knit through back loop on every knit stitch)', 'Half twist with purl stitches also twisted on wrong side'],
    },
    'twisted-k1-p1-full-twist': {
      id: 'twisted-k1-p1-full-twist', name: 'Twisted K1 P1 Ribbing (Full Twist)', difficulty: 'Intermediate', category: 'Ribbing',
      description: 'Both knit and purl stitches are twisted on every row for maximum stitch definition. Creates a dense, firm fabric with very pronounced ribbing.',
      instructions: ['Cast on an even number of stitches', 'Row 1: *Knit 1 through back loop, Purl 1 through back loop* repeat across', 'Row 2: Same as Row 1 — *K1 tbl, P1 tbl* repeat across', 'Repeat rows 1-2 for pattern'],
      tips: ['Produces the most defined ribbing possible with very small, tight stitches', 'The fabric is dense and not very stretchy — best for decorative panels rather than cuffs', 'Full twist means every stitch is twisted on every row for consistent texture', 'Use larger needles than usual to keep the fabric from being too stiff'],
      variations: ['Full twisted K2 P2 ribbing', 'Full twisted seed stitch', 'Full twisted rib in the round'],
    },
    'k2-p5-ribbing': {
      id: 'k2-p5-ribbing', name: 'K2 P5 Ribbing', difficulty: 'Intermediate', category: 'Ribbing',
      description: 'Alternating knit 2, purl 5 across the row. Creates bold, wide vertical stripes with a strong column of knits standing out against a purl background.',
      instructions: ['Cast on a multiple of 7 stitches', 'Row 1: *Knit 2, Purl 5* repeat across', 'Row 2: *Knit 5, Purl 2* repeat across', 'Repeat rows 1-2 for pattern'],
      tips: ['Not as stretchy as narrow ribbing due to the wide purl sections', 'The knit columns stand out prominently against the purl background', 'Use this pattern for sweater bodies, cardigan sides, or textured accessories', 'Cast on in multiples of 7 for pattern repeat'],
      variations: ['K3 P5 ribbing for thicker knit columns', 'K2 P3 ribbing for a more balanced stripe width', 'K2 P5 with twisted knits for extra column definition'],
    }
  };

  function useRouter() {
    const [currentRoute, setCurrentRoute] = useState('/');
    const navigate = (path) => setCurrentRoute(path);
    return { currentRoute, navigate };
  }

  const SearchIcon = () => h('svg', { className: 'w-5 h-5', fill: 'none', stroke: 'currentColor', viewBox: '0 0 24 24' }, h('path', { strokeLinecap: 'round', strokeLinejoin: 'round', strokeWidth: 2, d: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z' }));
  const ChevronLeftIcon = () => h('svg', { className: 'w-5 h-5', fill: 'none', stroke: 'currentColor', viewBox: '0 0 24 24' }, h('path', { strokeLinecap: 'round', strokeLinejoin: 'round', strokeWidth: 2, d: 'M15 19l-7-7 7-7' }));
  const BookIcon = () => h('svg', { className: 'w-6 h-6', fill: 'none', stroke: 'currentColor', viewBox: '0 0 24 24' }, h('path', { strokeLinecap: 'round', strokeLinejoin: 'round', strokeWidth: 2, d: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' }));
  const PlayIcon = () => h('svg', { className: 'w-6 h-6', fill: 'none', stroke: 'currentColor', viewBox: '0 0 24 24' }, h('path', { strokeLinecap: 'round', strokeLinejoin: 'round', strokeWidth: 2, d: 'M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1m-6 4h.01M12 5a9 9 0 019 9 9 9 0 01-9 9 9 9 0 01-9-9 9 9 0 019-9z' }));
  const LightbulbIcon = () => h('svg', { className: 'w-6 h-6', fill: 'none', stroke: 'currentColor', viewBox: '0 0 24 24' }, h('path', { strokeLinecap: 'round', strokeLinejoin: 'round', strokeWidth: 2, d: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z' }));

  const StitchCard = ({ stitch, onClick }) => {
    return h('div', {
      className: 'bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow cursor-pointer border-l-4 border-gray-400 flex flex-col justify-between',
      onClick: () => onClick(stitch.id)
    }, [
      h('div', { key: 'content' }, [
        h('div', { key: 'header', className: 'flex justify-between items-start mb-3' }, [
          h('h3', { key: 'title', className: 'text-xl font-semibold text-gray-800 mb-3' }, stitch.name),
          h('span', {
            key: 'difficulty',
            className: `px-2 py-1 rounded-full text-xs font-medium ${stitch.difficulty === 'Beginner' ? 'bg-green-100 text-green-800' : stitch.difficulty === 'Intermediate' ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800'}`
          }, stitch.difficulty)
        ]),
        h('p', { key: 'description', className: 'text-gray-600 mb-4' }, stitch.description),
      ]),
      h('div', { key: 'footer', className: 'flex justify-between items-center mt-auto' }, [
        h('span', { key: 'category', className: 'text-sm text-gray-700 font-medium' }, stitch.category),
      ])
    ]);
  };

  const StitchDetail = ({ stitch, onBack }) => {
    return h('div', {
      className: 'max-w-4xl mx-auto px-6 py-6'
    }, [
      h('div', { key: 'main', className: 'mb-6' }, [
        h('button', {
          key: 'back-btn',
          onClick: onBack,
          className: 'flex items-center text-gray-700 hover:text-gray-800 mb-4'
        }, [
          h(ChevronLeftIcon, { key: 'icon' }),
          ' Back to Library'
        ]),
        h('div', { key: 'content', className: 'bg-white rounded-lg shadow-lg overflow-hidden' }, [
          h('div', { key: 'header', className: 'stitch-header p-6' }, [
            h('div', { className: 'flex justify-between items-start' }, [
              h('div', { key: 'left' }, [
                h('h1', { key: 'title', className: 'text-3xl font-bold mb-2' }, stitch.name),
                h('p', { key: 'desc', className: 'stitch-header-subtle text-lg' }, stitch.description)
              ]),
              h('div', { key: 'right', className: 'text-right' }, [
                h('span', {
                  key: 'difficulty',
                  className: `px-3 py-1 rounded-full text-sm font-medium ${stitch.difficulty === 'Beginner' ? 'bg-green-500 text-white' : stitch.difficulty === 'Intermediate' ? 'bg-yellow-500 text-white' : 'bg-red-500 text-white'}`
                }, stitch.difficulty),
                h('div', { key: 'category', className: 'mt-2 stitch-header-subtle' }, stitch.category)
              ])
            ])
          ]),
          h('div', { key: 'body', className: 'p-6' }, [
            h('div', { key: 'grid', className: 'grid lg:grid-cols-2 gap-8' }, [
              h('div', { key: 'instructions' }, [
                h('div', { key: 'inst-header', className: 'flex items-center mb-4' }, [
                  h(BookIcon, { key: 'icon' }),
                  h('h2', { key: 'title', className: 'text-2xl font-semibold text-gray-800 ml-2' }, 'Pattern Instructions')
                ]),
                h('ol', { key: 'inst-list', className: 'space-y-3' }, stitch.instructions.map((instruction, index) =>
                  h('li', { key: index, className: 'flex' }, [
                    h('span', { key: 'number', className: 'bg-gray-200 text-gray-800 rounded-full w-8 h-8 flex items-center justify-center text-sm font-medium mr-3 flex-shrink-0' }, index + 1),
                    h('span', { key: 'text', className: 'text-gray-700 leading-relaxed' }, instruction)
                  ])
                ))
              ]),
              h('div', { key: 'video' }, [
                h('div', { key: 'video-header', className: 'flex items-center mb-4' }, [
                  h(PlayIcon, { key: 'icon' }),
                  h('h2', { key: 'title', className: 'text-2xl font-semibold text-gray-800 ml-2' }, 'Video Tutorial')
                ]),
                h('div', { key: 'video-container', className: 'aspect-video bg-gray-100 rounded-lg overflow-hidden' }, [
                  h('a', {
                    href: `https://www.youtube.com/results?search_query=${encodeURIComponent(stitch.name + ' knitting tutorial')}`,
                    target: '_blank',
                    rel: 'noopener noreferrer',
                    className: 'inline-block w-full h-full text-center text-gray-700 hover:text-gray-900 font-semibold underline py-12'
                  }, `🔗 Search for "${stitch.name} knitting tutorial" on YouTube`)
                ])
              ])
            ]),
            h('div', { key: 'tips', className: 'mt-8' }, [
              h('div', { key: 'tips-header', className: 'flex items-center mb-4' }, [
                h(LightbulbIcon, { key: 'icon' }),
                h('h2', { key: 'title', className: 'text-2xl font-semibold text-gray-800 ml-2' }, 'Tips & Tricks')
              ]),
              h('div', { key: 'tips-content', className: 'bg-yellow-50 rounded-lg p-4' }, [
                h('ul', { key: 'tips-list', className: 'space-y-2' }, stitch.tips.map((tip, index) =>
                  h('li', { key: index, className: 'flex items-start' }, [
                    h('span', { key: 'icon', className: 'text-yellow-600 mr-2' }, '💡'),
                    h('span', { key: 'text', className: 'text-gray-700' }, tip)
                  ])
                ))
              ])
            ]),
            h('div', { key: 'variations', className: 'mt-8' }, [
              h('h2', { key: 'var-title', className: 'text-2xl font-semibold text-gray-800 mb-4' }, 'Variations'),
              h('div', { key: 'var-grid', className: 'grid md:grid-cols-2 lg:grid-cols-3 gap-4' }, stitch.variations.map((variation, index) =>
                h('div', { key: index, className: 'bg-gray-100 rounded-lg p-4 border-l-4 border-gray-400' }, [
                  h('span', { key: 'text', className: 'text-gray-800 font-medium' }, variation)
                ])
              ))
            ])
          ])
        ])
      ])
    ]);
  };

  const HomePage = ({ stitches, onStitchClick, searchTerm, onSearchChange }) => {
    const [selectedCategory, setSelectedCategory] = useState('All');
    const categories = ['All', ...new Set(Object.values(stitches).map(s => s.category))];

    const filteredStitches = Object.values(stitches).filter(stitch => {
      const matchesSearch = stitch.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
        stitch.description.toLowerCase().includes(searchTerm.toLowerCase());
      const matchesCategory = selectedCategory === 'All' || stitch.category === selectedCategory;
      return matchesSearch && matchesCategory;
    });

    return h(Fragment, {}, [
      h('div', {
        key: 'header',
        className: 'stitch-header py-12'
      }, [
        h('div', {
          key: 'header-content',
          className: 'max-w-6xl mx-auto px-6 text-center'
        }, [
          h('h1', { key: 'title', className: 'text-4xl font-bold mb-4' }, 'Knitting Stitch Pattern Library'),
          h('p', { key: 'subtitle', className: 'text-xl stitch-header-subtle' }, 'Browse, search, and learn knitting stitch patterns')
        ])
      ]),
      h('div', {
        key: 'content-wrapper',
        className: 'max-w-6xl mx-auto px-6 py-8'
      }, [
        h('div', {
          key: 'search-filters',
          className: 'flex flex-col md:flex-row gap-4 mb-6'
        }, [
          h('div', {
            key: 'search-container',
            className: 'flex-1 flex items-center border border-gray-300 rounded-lg bg-white focus-within:ring-2 focus-within:ring-gray-500 focus-within:border-transparent transition-all'
          }, [
            h('div', { key: 'search-icon-wrapper', className: 'pl-3 pr-2 text-gray-400' }, [
              h(SearchIcon, {})
            ]),
            h('input', {
              key: 'search-input', type: 'text', placeholder: 'Search stitch patterns...', value: searchTerm,
              onChange: (e) => onSearchChange(e.target.value),
              className: 'w-full py-2 bg-transparent border-none focus:ring-0 focus:outline-none'
            })
          ]),
          h('select', {
            key: 'category-select', value: selectedCategory,
            onChange: (e) => setSelectedCategory(e.target.value),
            className: 'px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-gray-500 focus:border-gray-500'
          }, categories.map(category => h('option', { key: category, value: category }, category)))
        ]),
        h('div', {
          key: 'stats',
          className: 'grid grid-cols-2 md:grid-cols-4 gap-4 mb-8'
        }, [
          h('div', { key: 'total', className: 'text-center p-4 bg-white rounded-lg shadow' }, [
            h('div', { key: 'number', className: 'text-2xl font-bold text-gray-800' }, Object.keys(stitches).length),
            h('div', { key: 'label', className: 'text-gray-600' }, 'Total Patterns')
          ]),
          h('div', { key: 'beginner', className: 'text-center p-4 bg-white rounded-lg shadow' }, [
            h('div', { key: 'number', className: 'text-2xl font-bold text-green-600' }, Object.values(stitches).filter(s => s.difficulty === 'Beginner').length),
            h('div', { key: 'label', className: 'text-gray-600' }, 'Beginner')
          ]),
          h('div', { key: 'intermediate', className: 'text-center p-4 bg-white rounded-lg shadow' }, [
            h('div', { key: 'number', className: 'text-2xl font-bold text-yellow-600' }, Object.values(stitches).filter(s => s.difficulty === 'Intermediate').length),
            h('div', { key: 'label', className: 'text-gray-600' }, 'Intermediate')
          ]),
          h('div', { key: 'advanced', className: 'text-center p-4 bg-white rounded-lg shadow' }, [
            h('div', { key: 'number', className: 'text-2xl font-bold text-red-600' }, Object.values(stitches).filter(s => s.difficulty === 'Advanced').length),
            h('div', { key: 'label', className: 'text-gray-600' }, 'Advanced')
          ])
        ]),
        h('div', {
          key: 'stitch-grid',
          className: 'grid md:grid-cols-2 lg:grid-cols-3 gap-6'
        }, filteredStitches.map(stitch =>
          h(StitchCard, { key: stitch.id, stitch: stitch, onClick: onStitchClick })
        )),
        filteredStitches.length === 0 && h('div', { key: 'no-results', className: 'text-center py-12' }, [
          h('div', { key: 'emoji', className: 'text-6xl mb-4' }, '🧐'),
          h('p', { key: 'message', className: 'text-gray-600 text-lg' }, 'No stitch patterns found. Try a different search!')
        ])
      ])
    ]);
  };

  const KnittingStitchLibrary = () => {
    const { currentRoute, navigate } = useRouter();
    const [searchTerm, setSearchTerm] = useState('');

    const currentStitch = currentRoute.startsWith('/stitch/')
      ? stitchLibrary[currentRoute.replace('/stitch/', '')]
      : null;

    return h('div', { className: 'w-full' }, [
        currentRoute === '/' ?
          h(HomePage, {
            key: 'homepage',
            stitches: stitchLibrary,
            onStitchClick: (stitchId) => navigate(`/stitch/${stitchId}`),
            searchTerm: searchTerm,
            onSearchChange: setSearchTerm
          }) :
        currentStitch ?
          h(StitchDetail, {
            key: 'stitch-detail',
            stitch: currentStitch,
            onBack: () => navigate('/')
          }) :
          h('div', { key: 'not-found', className: 'max-w-6xl mx-auto px-6 text-center py-12' }, [
            h('h2', { key: 'title', className: 'text-2xl font-bold text-gray-800 mb-4' }, '404 - Stitch Pattern Not Found'),
            h('button', { key: 'return-btn', onClick: () => navigate('/'), className: 'text-gray-700 hover:text-gray-800' }, 'Return to Library')
          ])
    ]);
  };

  const container = document.getElementById('knitting-stitch-library');
  if (container) {
    container.innerHTML = '';

    const shadowRoot = container.attachShadow({ mode: 'open' });

    const tailwindLink = document.createElement('link');
    tailwindLink.rel = 'stylesheet';
    tailwindLink.href = 'https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css';
    shadowRoot.appendChild(tailwindLink);

    const customStyles = document.createElement('style');
    customStyles.textContent = `
      :host {
        width: 100%;
        min-height: 600px;
      }
      * {
        box-sizing: border-box;
      }
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb {
        background: #6b7280;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #4b5563;
      }
      .aspect-video {
        position: relative;
        width: 100%;
        padding-bottom: 56.25%;
      }
      .aspect-video > * {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .stitch-header {
        background: var(--warm-bg);
        color: var(--warm-text);
        border-bottom: 1px solid var(--warm-border);
      }
      .stitch-header-subtle {
        color: var(--warm-subtle);
      }

      :host([data-theme='dark']) .bg-white { background-color: #242320; }
      :host([data-theme='dark']) .bg-gray-50 { background-color: #1a1a17; }
      :host([data-theme='dark']) .bg-gray-100 { background-color: #2d2b27; }
      :host([data-theme='dark']) .bg-gray-200 { background-color: #33322e; }
      :host([data-theme='dark']) .bg-yellow-50 { background-color: #3b3520; }

      :host([data-theme='dark']) .text-gray-800 { color: #e8e6df; }
      :host([data-theme='dark']) .text-gray-700 { color: #d0ccc2; }
      :host([data-theme='dark']) .text-gray-600 { color: #a09c94; }

      :host([data-theme='dark']) .border-gray-400,
      :host([data-theme='dark']) .border-gray-300 { border-color: #33322e; }

      :host([data-theme='dark']) .text-green-600 { color: #4ade80; }
      :host([data-theme='dark']) .text-yellow-600 { color: #eab308; }
      :host([data-theme='dark']) .text-red-600 { color: #f87171; }

      :host([data-theme='dark']) ::-webkit-scrollbar-track { background: #242320; }
      :host([data-theme='dark']) ::-webkit-scrollbar-thumb { background: #4b5563; }
      :host([data-theme='dark']) ::-webkit-scrollbar-thumb:hover { background: #6b7280; }
    `;
    shadowRoot.appendChild(customStyles);

    const reactRootEl = document.createElement('div');
    reactRootEl.id = 'react-root';
    shadowRoot.appendChild(reactRootEl);

    const root = createRoot(reactRootEl);
    root.render(h(KnittingStitchLibrary));

    function syncTheme() {
      const theme = document.documentElement.getAttribute('data-theme');
      if (theme) {
        shadowRoot.host.setAttribute('data-theme', theme);
      }
    }

    syncTheme();

    const themeObserver = new MutationObserver(syncTheme);
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme']
    });
  }
}
</script>
